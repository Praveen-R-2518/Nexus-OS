{
  "id": "qWHvc2AmqX10jEjk",
  "name": "WF4 - Follow-up Scheduler",
  "active": true,
  "note": "Hardened 2026-09-01: no Supabase service-role. Schedule every 15 min → POST {NEXUS_APP_URL}/api/internal/n8n/followups/drain with N8N_BOOTSTRAP_TOKEN (or legacy N8N_INGEST_TOKEN). App claims due follow-ups and writes approval-gated reply drafts.",
  "nodes": [
    {
      "id": "sn-wf4",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {
        "content": "## Nexus OS — WF4 Follow-up Scheduler\n\nPOST `/api/internal/n8n/followups/drain` with bootstrap token.\nThe app claims due follow-ups and writes approval-gated drafts — no Supabase REST.\n\n**Required n8n Variables:** `NEXUS_APP_URL`, `N8N_BOOTSTRAP_TOKEN` (or legacy `N8N_INGEST_TOKEN`).\n\n**Do NOT** use Supabase service-role credentials in this workflow.",
        "height": 240,
        "width": 420
      }
    },
    {
      "id": "5860d069-eb09-4173-b209-6f35780671e8",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [240, 240],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "drain-wf4",
      "name": "Drain Due Follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [480, 240],
      "parameters": {
        "method": "POST",
        "url": "={{ ($vars.NEXUS_APP_URL || 'https://nexusos.knurdz.org').replace(/\\/$/, '') + '/api/internal/n8n/followups/drain' }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ ($vars.N8N_BOOTSTRAP_TOKEN || $vars.N8N_INGEST_TOKEN || '').trim() }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { limit: 10 } }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Drain Due Follow-ups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  }
}
